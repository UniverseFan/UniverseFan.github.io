---
import SectionPage from "@/layouts/SectionPage.astro";
import { getCollection } from "astro:content";
import EntryFeed from "@/components/EntryFeed.astro";
const entries = (await getCollection("cook", ({ data }) => data.published)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<SectionPage
  title="Cook"
  eyebrow="02 / Kitchen notes"
  description="做饭是一个很具体的成长过程。这里记录我学会的新菜、失败的尝试，以及下一次想做得更好的地方。"
  accent="bg-pyellow"
>
  <EntryFeed entries={entries} section="cook" emptyMessage="下一道菜，等待上桌。" />
</SectionPage>
