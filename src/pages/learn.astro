---
import SectionPage from "@/layouts/SectionPage.astro";
import { getCollection } from "astro:content";
import EntryFeed from "@/components/EntryFeed.astro";
const entries = (await getCollection("learn", ({ data }) => data.published)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<SectionPage
  title="Learn"
  eyebrow="03 / Learning log"
  description="把输入变成自己的表达。这里存放技术学习、阅读思考，以及解决问题时值得回看的过程。"
  accent="bg-ppink"
>
  <EntryFeed entries={entries} section="learn" emptyMessage="第一份笔记，正在路上。" />
</SectionPage>
