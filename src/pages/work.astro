---
import SectionPage from "@/layouts/SectionPage.astro";
---

<SectionPage
  title="Work"
  eyebrow="04 / Experience"
  description="后端、大模型方向的学习者与实践者。"
  accent="bg-pgreen"
>
  <div class="space-y-10">
    <section>
      <p class="text-pblack text-sm font-semibold">教育经历</p>
      <div class="mt-4 border-l-3 border-black pl-5 space-y-5">
        <div>
          <div class="flex flex-wrap justify-between gap-2"><h2 class="text-2xl font-bold">北京邮电大学</h2><p>2023.09 - 2026.06</p></div>
          <p class="mt-1">网络空间安全硕士</p>
        </div>
        <div>
          <div class="flex flex-wrap justify-between gap-2"><h2 class="text-2xl font-bold">华北电力大学（北京）</h2><p>2019.09 - 2023.06</p></div>
          <p class="mt-1">计算机科学与技术本科</p>
        </div>
      </div>
    </section>
    <section>
      <p class="text-pblack text-sm font-semibold">经历</p>
      <div class="mt-4 grid gap-5">
        <article class="border-1 border-black rounded-lg p-6">
          <div class="flex flex-wrap justify-between gap-2"><h2 class="text-2xl font-bold">交通银行</h2><p>2026.8 - </p></div>
          <p class="mt-2 font-semibold">agent开发、算法工程</p>
        </article>
        <article class="border-1 border-black rounded-lg p-6">
          <div class="flex flex-wrap justify-between gap-2"><h2 class="text-2xl font-bold">高德地图</h2><p>2025.04 - 2025.08</p></div>
          <p class="mt-2 font-semibold">后端开发实习生</p>
        </article>
        <article class="border-1 border-black rounded-lg p-6">
          <div class="flex flex-wrap justify-between gap-2"><h2 class="text-2xl font-bold">滴滴出行</h2><p>2024.11 - 2025.04</p></div>
          <p class="mt-2 font-semibold">后端开发实习生</p>
        </article>
      </div>
    </section>
  </div>
</SectionPage>
