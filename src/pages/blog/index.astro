---
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getCollection } from "astro:content";
import FormattedDate from "@/components/FormattedDate.astro";
import EntryFeed from "@/components/EntryFeed.astro";

const posts = (await getCollection("blog", ({ data }) => data.published)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Blogs | Evan.Zhang" description="Evan Zhang 的玩乐记录。" />
  </head>
  <body>
    <Header />
    <main class="container mx-auto px-4 md:px-10 py-14 md:py-20">
      <section class="flex flex-col md:flex-row md:items-end justify-between gap-8">
        <div>
          <p class="text-pblack tracking-[0.18em] uppercase text-sm">01 / Blogs</p>
          <h1 class="mt-4 text-5xl md:text-7xl font-bold">正在发生的事。</h1>
          <p class="mt-5 max-w-xl text-lg leading-8">玩的、想的、路过的，都放在这里。</p>
        </div>
      </section>
      <EntryFeed entries={posts} section="blog" emptyMessage="第一篇，留给此刻。" />
    </main>
    <Footer />
  </body>
</html>
